{
  "name": "fmi-codes-website",
  "version": "1.0.0",
  "description": "FMI Codes Website",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "*.{html,js,json,css,md}": [
      "prettier --write"
    ],
    "frontend/**/*.{ts,tsx}": [
      "eslint --fix --config frontend/eslint.config.js",
      "prettier --write"
    ],
    "*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  }
}
