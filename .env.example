# ─────────────────────────────────────────────────────────
# FMI Codes 2026 — Environment variables template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# Use GitHub Secrets (or your deployment secret manager) for production values.
# ─────────────────────────────────────────────────────────

# Tells docker-compose which file to use by default so plain
# `docker-compose up --build` works without -f flags.
# Remove this line (or change to docker-compose.yml) when deploying to production.
COMPOSE_FILE=docker-compose.dev.yml

# ── Flask ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET

FLASK_ENV=production
FLASK_DEBUG=0

# ── Admin ────────────────────────────────────────────────
ADMIN_EMAIL=admin@fmicodes.bg
# Generate the bcrypt hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(12)).decode())"
# Store the output here (starts with $2b$12$...).  Never store the plaintext.
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH_OF_ADMIN_PASSWORD

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fmi_hackathon_2026
DB_USER=fmi_app          # Use a least-privilege role, not 'postgres' (see M5)
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Email / SMTP ─────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
# Use a Gmail App Password (not your account password).
# Store in GitHub Secrets as MAIL_PASSWORD.
MAIL_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_USE_TLS=true

# ── Discord ──────────────────────────────────────────────
# Store in GitHub Secrets as DISCORD_BUG_WEBHOOK_URL.
DISCORD_BUG_WEBHOOK_URL=REPLACE_WITH_DISCORD_WEBHOOK_URL

# ── Redis ────────────────────────────────────────────────
# Used for: JWT revocation blocklist (H1) + rate-limiter shared storage (H7).
REDIS_URL=redis://redis:6379

# Sentinel mode: used when running against Sentinel; leave unset to use REDIS_URL directly.
# When REDIS_SENTINELS + REDIS_MASTER_NAME are both set they take precedence over REDIS_URL.
# In k8s these will later be injected for a Helm-managed Sentinel service — no app code changes.
REDIS_SENTINELS=
REDIS_MASTER_NAME=
REDIS_SOCKET_TIMEOUT=2
REDIS_CONNECT_TIMEOUT=2

# ── Feature flags ────────────────────────────────────────
MENTORS_STAY_TUNED=false
REGISTRATION_OPEN=false
RANKINGS_LIVE=false

# ── CORS ─────────────────────────────────────────────────
FRONTEND_ORIGIN=https://fmicodes.bg
