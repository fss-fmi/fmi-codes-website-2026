# FMI{Codes} 2026 — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real secrets.
#
# This file configures LOCAL dev (python dev.py / docker compose). In the k3s
# cluster the backend gets its config from a ConfigMap + SOPS-encrypted
# Secrets instead of a .env — see docs/runbook.md.

# Makes a bare `docker compose up` use the dev stack (single Redis, hot reload).
# Delete this line to target docker-compose.yml (the prod-like Sentinel stack).
COMPOSE_FILE=docker-compose.dev.yml

# ── Flask ────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET
JWT_EXPIRY_DAYS=3

# ── Admin (seeded on first run) ──────────────────────────
ADMIN_EMAIL=admin@fmicodes.bg
# bcrypt hash of the admin password — never store the plaintext.
#   python -c "import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fmi_hackathon_2026
# Prefer a least-privilege role over the postgres superuser.
DB_USER=fmi_app
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_TIMEOUT=5

# ── Redis (rate limiting, JWT revocation, caches) ────────
# Single-instance mode. Leave every REDIS_* unset to run without Redis
# (the app degrades gracefully to in-memory / DB fallbacks).
REDIS_URL=redis://localhost:6379
# Sentinel (HA) mode — set both to override REDIS_URL. This is what the cluster uses.
REDIS_SENTINELS=
REDIS_MASTER_NAME=
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=2
REDIS_CONNECT_TIMEOUT=2

# ── Email / SMTP (password-reset mails) ──────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
# Gmail App Password, not your account password.
MAIL_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_USE_TLS=true

# ── Feature flags ────────────────────────────────────────
MENTORS_STAY_TUNED=false
REGISTRATION_OPEN=false
RANKINGS_LIVE=false
# Block unverified participants from creating, joining or applying to teams.
# Turn on only once SMTP is confirmed working.
REQUIRE_EMAIL_VERIFICATION=false

# ── Frontend origin (CORS) ───────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Contact section links (optional — empty value hides the entry) ──
DISCORD_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
CONTACT_EMAIL=
CONTACT_PHONE=

# ── Bug reports → Discord webhook (optional) ─────────────
DISCORD_BUG_WEBHOOK_URL=

# ── Migration results → Slack incoming webhook (optional) ──
SLACK_MIGRATIONS_WEBHOOK_URL=
